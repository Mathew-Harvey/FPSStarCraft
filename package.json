{
  "name": "ore-else",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.mjs",
    "test:rules": "node tools/run-ts.mjs test/matchups.ts",
    "sim": "node tools/run-ts.mjs tools/sim.ts",
    "test": "node tools/run-ts.mjs test/matchups.ts && node test/server.mjs && node test/coop.mjs && node test/versus.mjs && node test/split.mjs && node test/touch.mjs && node test/veyl.mjs && node test/gloam.mjs && node test/sweep.mjs"
  },
  "dependencies": {
    "three": "0.160.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.160.0",
    "@types/ws": "^8.5.12",
    "esbuild": "0.21.5",
    "typescript": "5.4.5"
  }
}
