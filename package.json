{
  "name": "ore-else",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.mjs",
    "test:rules": "node tools/run-ts.mjs test/matchups.ts",
    "test:scout": "node tools/run-ts.mjs test/scouting.ts",
    "test:core": "node tools/run-ts.mjs test/core/registry.ts && node tools/run-ts.mjs test/core/systems.ts",
    "sim": "node tools/run-ts.mjs tools/sim.ts",
    "test": "node tools/test-all.mjs",
    "test:command": "node test/command.mjs",
    "test:controls": "node test/controls.mjs"
  },
  "dependencies": {
    "three": "0.160.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "0.160.0",
    "@types/ws": "^8.5.12",
    "esbuild": "0.21.5",
    "fflate": "^0.6.11",
    "typescript": "5.4.5"
  }
}
